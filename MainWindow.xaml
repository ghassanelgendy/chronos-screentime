                                                   FontWeight="SemiBold" 
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                                   Margin="0,0,0,6"/>
                                        <TextBlock Text="Year > Month (Avg hours)" 
                                                   FontSize="11" 
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <TreeView x:Name="SleepNavigationTree" 
                                                  Background="Transparent" 
                                                  BorderThickness="0"
                                                  SelectedItemChanged="SleepNavigationTree_SelectedItemChanged">
                                            <TreeView.ItemContainerStyle>
                                                <Style TargetType="TreeViewItem">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                    <Setter Property="FontSize" Value="14"/>
                                                    <Setter Property="Margin" Value="0,2"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="TreeViewItem">
                                                                <Grid>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="*"/>
                                                                    </Grid.RowDefinitions>
                                                                    <Border x:Name="ItemBorder" 
                                                                            Grid.Row="0"
                                                                            Background="Transparent" 
                                                                            CornerRadius="6" 
                                                                            Padding="8,6">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <ToggleButton x:Name="Expander" 
                                                                                          Grid.Column="0"
                                                                                          Background="Transparent" 
                                                                                          BorderThickness="0" 
                                                                                          Width="16" 
                                                                                          Height="16"
                                                                                          Margin="0,0,8,0"
                                                                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                                                                          ClickMode="Press">
                                                                                <ToggleButton.Template>
                                                                                    <ControlTemplate TargetType="ToggleButton">
                                                                                        <Border Background="Transparent">
                                                                                            <TextBlock x:Name="ExpanderIcon" 
                                                                                                       Text="▶" 
                                                                                                       FontSize="10" 
                                                                                                       HorizontalAlignment="Center" 
                                                                                                       VerticalAlignment="Center"
                                                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                                                        </Border>
                                                                                        <ControlTemplate.Triggers>
                                                                                            <Trigger Property="IsChecked" Value="True">
                                                                                                <Setter TargetName="ExpanderIcon" Property="Text" Value="▼"/>
                                                                                            </Trigger>
                                                                                        </ControlTemplate.Triggers>
                                                                                    </ControlTemplate>
                                                                                </ToggleButton.Template>
                                                                            </ToggleButton>
                                                                            <ContentPresenter x:Name="PART_Header" 
                                                                                              Grid.Column="1"
                                                                                              ContentSource="Header" 
                                                                                              VerticalAlignment="Center"/>
                                                                        </Grid>
                                                                    </Border>
                                                                    <ItemsPresenter Grid.Row="1" 
                                                                                    x:Name="ItemsHost" 
                                                                                    Margin="24,0,0,0"/>
                                                                </Grid>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsExpanded" Value="False">
                                                                        <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                                                                    </Trigger>
                                                                    <Trigger Property="HasItems" Value="False">
                                                                        <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </TreeView.ItemContainerStyle>
                                        </TreeView>
                                    </ScrollViewer>
                                </Grid>
                            </ui:Card>
                            
                            <!-- Sleep Data List -->
                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="12,0,0,0">
                                <StackPanel>
                                    <!-- Current Selection Header -->
                                    <ui:Card Margin="0,0,0,20" Padding="24">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock x:Name="CurrentSelectionTitle" 
                                                           Text="All Sleep Data" 
                                                           FontSize="18" 
                                                           FontWeight="SemiBold" 
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                <TextBlock x:Name="CurrentSelectionSubtitle" 
                                                           Text="Showing all available sleep sessions" 
                                                           FontSize="12" 
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBlock x:Name="CurrentSelectionCount" 
                                                           Text="0 sessions" 
                                                           FontSize="14" 
                                                           FontWeight="SemiBold" 
                                                           Foreground="{DynamicResource AccentFillColorDefaultBrush}" 
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </ui:Card>
                                    
                                    <!-- Sleep Sessions -->
                                    <ItemsControl x:Name="SleepDataList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ui:Card Margin="0,0,0,16" Padding="24">
                                                    <ui:Card.Style>
                                                        <Style TargetType="ui:Card">
                                                            <Setter Property="Cursor" Value="Hand"/>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ui:Card.Style>
                                                    <ui:Card.InputBindings>
                                                        <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.OpenSleepDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                    </ui:Card.InputBindings>
                                                    <Border Tag="{Binding}" MouseLeftButtonDown="SleepDayCard_Click" Background="Transparent">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            
                                                            <!-- Left Content -->
                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                <!-- Date -->
                                                                <TextBlock Text="{Binding Date, StringFormat='{}{0:dddd, MMMM dd, yyyy}'}" 
                                                                          FontSize="16" 
                                                                          FontWeight="SemiBold" 
                                                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                          Margin="0,0,0,6"/>
                                                                
                                                                <!-- Session Count and Details -->
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Border Background="{DynamicResource AccentFillColorSecondaryBrush}" 
                                                                            CornerRadius="12" 
                                                                            Padding="8,4">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="{Binding SessionCount}" 
                                                                                      FontSize="11" 
                                                                                      FontWeight="SemiBold"
                                                                                      Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                                                            <TextBlock Text=" sessions" 
                                                                                      FontSize="11" 
                                                                                      Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                    <TextBlock Text="{Binding FormattedDetails}" 
                                                                              FontSize="12" 
                                                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                              TextTrimming="CharacterEllipsis"
                                                                              Margin="12,0,0,0"
                                                                              VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                            
                                                            <!-- Total Sleep Time -->
                                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding FormattedTotalTime}" 
                                                                          FontSize="20" 
                                                                          FontWeight="Bold"
                                                                          Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                                                          HorizontalAlignment="Right"/>
                                                                <TextBlock Text="total sleep" 
                                                                          FontSize="11" 
                                                                          Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                          HorizontalAlignment="Right"
                                                                          Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </ui:Card>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                    
                    <!-- Charts Content -->
                    <Grid x:Name="ChartsContent" Visibility="Collapsed">
                        <Grid.RenderTransform>
                            <TranslateTransform/>
                        </Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <ui:Card Grid.Row="0" Margin="0,0,0,16" Padding="16">
                            <Grid>
                                <ui:Button HorizontalAlignment="Left"
                                           Content="← Back"
                                           Appearance="Secondary"
                                           Click="BackToMain_Click"/>
                                <TextBlock Text="Charts &amp; Analytics"
                                         FontSize="20"
                                         FontWeight="SemiBold"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                                <TextBlock Text="📊"
                                         FontSize="24"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Center"/>
                            </Grid>
                        </ui:Card>

                        <!-- Chart Controls -->
                        <Border Grid.Row="1" Background="{DynamicResource LayerFillColorDefaultBrush}" Padding="20" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Time Period Selection -->
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock Text="Time Period" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <ComboBox x:Name="ChartTimePeriodComboBox" Width="150" HorizontalAlignment="Center" SelectionChanged="ChartTimePeriod_SelectionChanged">
                                        <ComboBoxItem Content="Today" Tag="Today" IsSelected="True"/>
                                        <ComboBoxItem Content="Yesterday" Tag="Yesterday"/>
                                        <ComboBoxItem Content="This Week" Tag="ThisWeek"/>
                                        <ComboBoxItem Content="Last Week" Tag="LastWeek"/>
                                        <ComboBoxItem Content="This Month" Tag="ThisMonth"/>
                                        <ComboBoxItem Content="This Year" Tag="ThisYear"/>
                                    </ComboBox>
                                </StackPanel>
                                
                                <!-- Data Type Selection -->
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock Text="Data Type" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <ComboBox x:Name="ChartDataTypeComboBox" Width="150" HorizontalAlignment="Center" SelectionChanged="ChartDataType_SelectionChanged">
                                        <ComboBoxItem Content="By Category" Tag="Category" IsSelected="True"/>
                                        <ComboBoxItem Content="By App/Website" Tag="Item"/>
                                    </ComboBox>
                                </StackPanel>
                                
                                <!-- Chart Type Selection -->
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock Text="Chart Type" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <ComboBox x:Name="ChartTypeComboBox" Width="150" HorizontalAlignment="Center" SelectionChanged="ChartType_SelectionChanged">
                                        <ComboBoxItem Content="Bar Chart" Tag="Bar" IsSelected="True"/>
                                        <ComboBoxItem Content="Line Chart" Tag="Line"/>
                                    </ComboBox>
                                </StackPanel>
                                
                                <!-- Zoom Reset Button (only visible for line chart) -->

                            </Grid>
                        </Border>

                        <!-- Chart Content -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="16">
                            <StackPanel>
                                <!-- Chart Container -->
                                <ui:Card Margin="0,0,0,20" Padding="24">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="400"/>
                                        </Grid.RowDefinitions>
                                        
                                        <!-- Chart Header -->
                                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                                            <TextBlock x:Name="ChartTitleText" Text="Today's Screen Time by Category" 
                                                       FontSize="18" FontWeight="SemiBold" 
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock x:Name="ChartSubtitleText" Text="Showing daily breakdown" 
                                                       FontSize="12" 
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                        
                                        <!-- Chart Canvas -->
                                        <Border Grid.Row="1" 
                                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="20">
                                            <Canvas x:Name="ChartCanvas" Background="Transparent"/>
                                        </Border>
                                    </Grid>
                                </ui:Card>
                                
                                <!-- Chart Legend -->
                                <ui:Card Margin="0,0,0,20" Padding="24">
                                    <StackPanel>
                                        <TextBlock Text="Legend" FontSize="16" FontWeight="SemiBold" 
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                                   Margin="0,0,0,12"/>
                                        <ItemsControl x:Name="ChartLegendList">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="4" Padding="8,4" 
                                                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                            CornerRadius="4">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="12" Height="12" Fill="{Binding Color}" Margin="0,0,8,0"/>
                                                            <TextBlock Text="{Binding Name}" FontSize="12" 
                                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                            <TextBlock Text=" - " FontSize="12" 
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                                                       Margin="4,0"/>
                                                            <TextBlock Text="{Binding Value}" FontSize="12" 
                                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ui:Card>
                                
                                <!-- Summary Stats -->
                                <ui:Card Margin="0,0,0,20" Padding="24">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Total Time -->
                                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                            <TextBlock Text="Total Time" FontSize="12" 
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="ChartTotalTimeText" Text="0h 0m" FontSize="20" FontWeight="Bold" 
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        
                                        <!-- Top Category -->
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                            <TextBlock Text="Top Category" FontSize="12" 
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="ChartTopCategoryText" Text="None" FontSize="16" FontWeight="SemiBold" 
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        
                                        <!-- Categories Count -->
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                            <TextBlock Text="Categories" FontSize="12" 
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="ChartCategoriesCountText" Text="0" FontSize="20" FontWeight="Bold" 
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </ui:Card>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                    
                    <!-- Preferences Content -->
                    <Grid x:Name="PreferencesContent" Visibility="Collapsed">
                        <Grid.RenderTransform>
                            <TranslateTransform/>
                        </Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <ui:Card Grid.Row="0" Margin="0,0,0,16" Padding="16">
                            <Grid>
                                <ui:Button HorizontalAlignment="Left"
                                           Content="← Back"
                                           Appearance="Secondary"
                                           Click="BackToMain_Click"/>
                                <TextBlock Text="Settings"
                                         FontSize="20"
                                         FontWeight="SemiBold"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                                <ui:Button HorizontalAlignment="Right"
                                           Content="💾 Apply Changes"
                                           Appearance="Primary"
                                           Click="ApplyPreferences_Click"
                                           Padding="16,8"/>
                            </Grid>
                        </ui:Card>

                        <!-- Settings Content -->
                        <ScrollViewer Grid.Row="1" x:Name="SettingsDetailContent" VerticalScrollBarVisibility="Auto" Margin="16">
                            <StackPanel Margin="0,0,0,24">
                                <!-- System Section -->
                                <ui:Card x:Name="SystemSettingsCard" Padding="24" Margin="0,0,0,24" Opacity="0">
                                    <ui:Card.RenderTransform>
                                        <TransformGroup>
                                            <TranslateTransform Y="40"/>
                                            <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                        </TransformGroup>
                                    </ui:Card.RenderTransform>
                                    <StackPanel>
                                        <TextBlock Text="System" 
                                                 FontSize="24" 
                                                 FontWeight="SemiBold" 
                                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                 Margin="0,0,0,20"/>

                                        <!-- Display -->
                                        <ui:CardExpander Header="Display" Icon="🖥️" Margin="0,0,0,16" IsExpanded="True">
                                            <StackPanel Margin="0,16,0,0">
                                                <StackPanel Margin="0,0,0,20">
                                                    <TextBlock Text="Theme" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                                    <ComboBox x:Name="PageThemeComboBox" Width="200" HorizontalAlignment="Left"
                                                            SelectionChanged="PageThemeComboBox_SelectionChanged">
                                                        <ComboBoxItem Content="Light Theme" Tag="Light" IsSelected="True"/>
                                                        <ComboBoxItem Content="Dark Theme" Tag="Dark"/>
                                                    </ComboBox>
                                                </StackPanel>
                                                <ui:ToggleSwitch x:Name="PageHideTitleBarCheckBox"
                                                               Content="Hide title bar"
                                                               ToolTip="Remove window title bar for cleaner look"
                                                               Checked="PageHideTitleBarCheckBox_Checked"
                                                               Unchecked="PageHideTitleBarCheckBox_Unchecked"
                                                               Margin="0,0,0,8"/>
                                            </StackPanel>
                                        </ui:CardExpander>

                                        <!-- Window Behavior -->
                                        <ui:CardExpander Header="Window Behavior" Icon="🪟" Margin="0,0,0,16" IsExpanded="True">
                                            <StackPanel Margin="0,16,0,0">
                                                <ui:ToggleSwitch x:Name="PageAlwaysOnTopCheckBox" 
                                                               Content="Always on top"
                                                               ToolTip="Keep Chronos window above other windows"
                                                               IsChecked="{Binding ElementName=AlwaysOnTopMenuItem, Path=IsChecked}"
                                                               Margin="0,0,0,12"/>
                                                <ui:ToggleSwitch x:Name="PageShowInSystemTrayCheckBox"
                                                               Content="Show in system tray"
                                                               ToolTip="Minimize to system tray instead of closing"
                                                               IsChecked="{Binding ElementName=ShowInTrayMenuItem, Path=IsChecked}"
                                                               Margin="0,0,0,12"/>
                                                <StackPanel Margin="0,0,0,8">
                                                    <TextBlock Text="Start with Windows" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                                    <ComboBox x:Name="PageStartWithWindowsComboBox" 
                                                            Width="200" 
                                                            HorizontalAlignment="Left"
                                                            SelectionChanged="PageStartWithWindowsComboBox_SelectionChanged">
                                                        <ComboBoxItem Content="No" Tag="No" IsSelected="True"/>
                                                        <ComboBoxItem Content="Yes" Tag="Yes"/>
                                                        <ComboBoxItem Content="Minimized" Tag="Minimized"/>
                                                    </ComboBox>
                                                </StackPanel>
                                            </StackPanel>
                                        </ui:CardExpander>

                                        <!-- Auto Export -->
                                        <ui:CardExpander Header="Auto Export" Icon="💾" Margin="0,0,0,16" IsExpanded="True">
                                            <StackPanel Margin="0,16,0,0">
                                                <ui:ToggleSwitch Content="Enable auto export"
                                                               ToolTip="Automatically export data at intervals"
                                                               Margin="0,0,0,16"/>
                                                <StackPanel Margin="0,0,0,8">
                                                    <TextBlock Text="Export frequency" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                                    <ComboBox Width="200" HorizontalAlignment="Left">
                                                        <ComboBoxItem Content="1 hour"/>
                                                        <ComboBoxItem Content="6 hours"/>
                                                        <ComboBoxItem Content="12 hours"/>
                                                        <ComboBoxItem Content="1 day" IsSelected="True"/>
                                                        <ComboBoxItem Content="1 week"/>
                                                    </ComboBox>
                                                </StackPanel>
                                            </StackPanel>
                                        </ui:CardExpander>

                                        <!-- Supabase Cloud Sync -->
                                        <ui:CardExpander Header="Cloud Sync (Supabase)" Icon="☁️" Margin="0,0,0,16" IsExpanded="True">
                                            <StackPanel Margin="0,16,0,0">
                                                <ui:InfoBar Title="Cloud Sync" 
                                                          Message="Sync your screentime data to Supabase for backup and cross-device access. Data uploads automatically every 5 hours (configurable)."
                                                          IsOpen="True"
                                                          Severity="Informational"
                                                          IsClosable="False"
                                                          Margin="0,0,0,16"/>
                                                <ui:ToggleSwitch x:Name="PageEnableSupabaseSyncCheckBox"
                                                               Content="Enable Supabase sync"
                                                               ToolTip="Automatically upload screentime data to Supabase"
                                                               Margin="0,0,0,16"/>
                                                <StackPanel Margin="0,0,0,16">
                                                    <TextBlock Text="Supabase URL" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                                    <TextBox x:Name="PageSupabaseUrlTextBox" 
                                                           Width="400" 
                                                           HorizontalAlignment="Left"
                                                           Margin="0,0,0,8"/>
                                                    <TextBlock Text="Example: https://your-project.supabase.co" 
                                                             FontSize="11" 
                                                             Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                             Margin="0,-4,0,8"/>
                                                </StackPanel>
                                                <StackPanel Margin="0,0,0,16">
                                                    <TextBlock Text="Supabase Anon Key" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                                    <PasswordBox x:Name="PageSupabaseAnonKeyPasswordBox" 
                                                              Width="400" 
                                                              HorizontalAlignment="Left"
                                                              PasswordChanged="PageSupabaseAnonKeyPasswordBox_PasswordChanged"
                                                              Margin="0,0,0,8"/>
                                                    <ui:Button x:Name="ToggleSupabaseKeyVisibilityButton"
                                                             Content="👁️ Show Key"
                                                             Click="ToggleSupabaseKeyVisibility_Click"
                                                             Appearance="Secondary"
                                                             HorizontalAlignment="Left"
                                                             Padding="8,4"
                                                             Margin="0,0,0,8"/>
                                                    <TextBox x:Name="PageSupabaseAnonKeyTextBox" 
                                                           Width="400" 
                                                           HorizontalAlignment="Left"
                                                           Visibility="Collapsed"
                                                           Margin="0,0,0,8"/>
                                                </StackPanel>
                                                <StackPanel Margin="0,0,0,16">
                                                    <TextBlock Text="User ID (UUID)" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                                    <TextBox x:Name="PageSupabaseUserIdTextBox" 
                                                           Width="400" 
                                                           HorizontalAlignment="Left"
                                                           Margin="0,0,0,8"/>
                                                    <TextBlock Text="Enter your LifeOS User ID (UUID format)" 
                                                             FontSize="11" 
                                                             Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                             Margin="0,-4,0,8"/>
                                                </StackPanel>
                                                <StackPanel Margin="0,0,0,8">
                                                    <TextBlock Text="Upload Interval" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                                    <Grid Width="200" HorizontalAlignment="Left">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <ui:NumberBox x:Name="PageSupabaseUploadIntervalHoursTextBox" 
                                                                    Grid.Column="0" 
                                                                    Value="5" 
                                                                    Minimum="1" 
                                                                    Maximum="168"/>
                                                        <TextBlock Grid.Column="1" Text="hours" 
                                                                 VerticalAlignment="Center" 
                                                                 Margin="8,0,0,0"/>
                                                    </Grid>
                                                    <TextBlock Text="Data will be uploaded automatically at the specified interval" 
                                                             FontSize="11" 
                                                             Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                             Margin="0,4,0,0"/>
                                                </StackPanel>
                                                <ui:Button x:Name="TestSupabaseConnectionButton"
                                                         Content="🔌 Test Connection" 
                                                         Click="TestSupabaseConnection_Click"
                                                         Appearance="Primary"
                                                         HorizontalAlignment="Left"
                                                         Padding="12,8"
                                                         Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </ui:CardExpander>

                                        <!-- Power Scheduling -->
                                        <ui:CardExpander Header="Power Scheduling" Icon="⚡" Margin="0,0,0,8" IsExpanded="True">
                                            <StackPanel Margin="0,16,0,0">
                                                <ui:InfoBar Title="Power Scheduling" 
                                                          Message="Schedule your computer to power off or restart automatically. Settings are non-persistent and reset when the application closes."
                                                          IsOpen="True"
                                                          Severity="Informational"
                                                          IsClosable="False"
                                                          Margin="0,0,0,16"/>
                                                <ui:ToggleSwitch x:Name="PageEnablePowerSchedulingCheckBox"
                                                               Content="Enable power scheduling"
                                                               ToolTip="Allow scheduling power off or restart actions"
                                                               Margin="0,0,0,16"/>
                                                <Grid Margin="0,0,0,16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                        <TextBlock Text="Default Hours" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                                        <ui:NumberBox x:Name="PagePowerScheduleHoursTextBox" 
                                                                    Value="0" 
                                                                    Minimum="0" 
                                                                    Maximum="24"
                                                                    SpinButtonPlacementMode="Compact"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                        <TextBlock Text="Default Minutes" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                                        <ui:NumberBox x:Name="PagePowerScheduleMinutesTextBox" 
                                                                    Value="30" 
                                                                    Minimum="0" 
                                                                    Maximum="59"
                                                                    SpinButtonPlacementMode="Compact"/>
                                                    </StackPanel>
                                                </Grid>
                                                <StackPanel Margin="0,0,0,8">
                                                    <TextBlock Text="Default Action" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                                    <ComboBox x:Name="PagePowerScheduleActionComboBox" 
                                                            Width="200" 
                                                            HorizontalAlignment="Left">
                                                        <ComboBoxItem Content="Power Off" Tag="Shutdown" IsSelected="True"/>
                                                        <ComboBoxItem Content="Restart" Tag="Restart"/>
                                                    </ComboBox>
                                                </StackPanel>
                                                <ui:Button x:Name="OpenPowerSchedulingDialogButton"
                                                         Content="⚡ Open Power Scheduling Dialog" 
                                                         Click="OpenPowerSchedulingDialog_Click"
                                                         Appearance="Primary"
                                                         HorizontalAlignment="Left"
                                                         Padding="12,8"
                                                         Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </ui:CardExpander>
                                    </StackPanel>
                                </ui:Card>

                                <!-- Notifications Section -->
                                <ui:Card x:Name="NotificationsSettingsCard" Padding="24" Margin="0,0,0,16" Opacity="0">
                                    <ui:Card.RenderTransform>
                                        <TransformGroup>
                                            <TranslateTransform Y="40"/>
                                            <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                        </TransformGroup>
                                    </ui:Card.RenderTransform>
                                    <StackPanel>
                                        <TextBlock Text="Notifications &amp; Wellness" 
                                                 FontSize="24" 
                                                 FontWeight="SemiBold" 
                                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                 Margin="0,0,0,20"/>

                                        <!-- Break Notifications -->
                                        <ui:CardExpander Header="Break Notifications" Icon="⏰" Margin="0,0,0,16" IsExpanded="True">
                                            <StackPanel Margin="0,16,0,0">
                                                <ui:ToggleSwitch x:Name="PageEnableBreakNotificationsCheckBox"
                                                               Content="Enable break notifications"
                                                               ToolTip="Get reminded to take regular breaks from your screen"
                                                               Margin="0,0,0,16"/>
                                                <StackPanel Margin="0,0,0,8">
                                                    <TextBlock Text="Break reminder interval" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                                    <Grid Width="200" HorizontalAlignment="Left">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <ui:NumberBox x:Name="PageBreakReminderMinutesTextBox" 
                                                                    Grid.Column="0" 
                                                                    Value="30" 
                                                                    Minimum="1" 
                                                                    Maximum="480"/>
                                                        <TextBlock Grid.Column="1" Text="minutes" 
                                                                 VerticalAlignment="Center" 
                                                                 Margin="8,0,0,0"/>
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                        </ui:CardExpander>



                                        <!-- Sound Settings -->
                                        <ui:CardExpander Header="Sound Settings" Icon="🔊" Margin="0,0,0,8" IsExpanded="True">
                                            <StackPanel Margin="0,16,0,0">
                                                <StackPanel Margin="0,0,0,16">
                                                    <TextBlock Text="Notification sound" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                                    <ComboBox x:Name="PageNotificationSoundComboBox" 
                                                            Width="250" 
                                                            HorizontalAlignment="Left"
                                                            SelectionChanged="PageNotificationSoundComboBox_SelectionChanged"/>
                                                </StackPanel>
                                                <StackPanel Margin="0,0,0,16">
                                                    <TextBlock Text="Volume" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                                    <Grid Width="300" HorizontalAlignment="Left">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Slider x:Name="PageNotificationVolumeSlider" 
                                                               Grid.Column="0"
                                                               Minimum="0" 
                                                               Maximum="100" 
                                                               Value="50"
                                                               TickFrequency="10"
                                                               IsSnapToTickEnabled="True"
                                                               VerticalAlignment="Center"
                                                               ValueChanged="PageNotificationVolumeSlider_ValueChanged"/>
                                                        <TextBlock x:Name="PageVolumeValueText" 
                                                                 Grid.Column="1"
                                                                 Text="50%" 
                                                                 VerticalAlignment="Center" 
                                                                 Margin="12,0,0,0" 
                                                                 FontWeight="SemiBold"
                                                                 MinWidth="40"/>
                                                    </Grid>
                                                </StackPanel>
                                                <StackPanel Margin="0,0,0,8">
                                                    <ui:Button x:Name="TestNotificationButton"
                                                             Content="🔔 Test Notification" 
                                                             Click="TestNotification_Click"
                                                             Appearance="Secondary"
                                                             HorizontalAlignment="Left"
                                                             Padding="12,8"/>
                                                </StackPanel>

                                            </StackPanel>
                                        </ui:CardExpander>
                                    </StackPanel>
                                </ui:Card>

                                <!-- Navigation Section -->
                                <ui:Card x:Name="NavigationSettingsCard" Padding="24" Margin="0,0,0,16" Opacity="0">
                                    <ui:Card.RenderTransform>
                                        <TransformGroup>
                                            <TranslateTransform Y="40"/>
                                            <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                        </TransformGroup>
                                    </ui:Card.RenderTransform>
                                    <StackPanel>
                                        <TextBlock Text="Navigation" 
                                                 FontSize="24" 
                                                 FontWeight="SemiBold" 
                                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                 Margin="0,0,0,20"/>

                                        <!-- Tab Visibility -->
                                        <ui:CardExpander Header="Tab Visibility" Icon="🗂️" Margin="0,0,0,8" IsExpanded="True">
                                            <StackPanel Margin="0,16,0,0">
                                                <TextBlock Text="Choose which navigation tabs to show or hide" 
                                                         FontSize="13" 
                                                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                         Margin="0,0,0,16"/>
                                                
                                                <!-- Time-based tabs -->
                                                <TextBlock Text="Time Periods" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                                <ui:ToggleSwitch x:Name="PageShowTodayTabCheckBox"
                                                               Content="Today"
                                                               ToolTip="Show or hide the Today tab"
                                                               IsChecked="True"
                                                               Margin="0,0,0,8"/>
                                                <ui:ToggleSwitch x:Name="PageShowYesterdayTabCheckBox"
                                                               Content="Yesterday"
                                                               ToolTip="Show or hide the Yesterday tab"
                                                               IsChecked="True"
                                                               Margin="0,0,0,8"/>
                                                <ui:ToggleSwitch x:Name="PageShowThisWeekTabCheckBox"
                                                               Content="This Week"
                                                               ToolTip="Show or hide the This Week tab"
                                                               IsChecked="True"
                                                               Margin="0,0,0,8"/>
                                                <ui:ToggleSwitch x:Name="PageShowLastWeekTabCheckBox"
                                                               Content="Last Week"
                                                               ToolTip="Show or hide the Last Week tab"
                                                               IsChecked="True"
                                                               Margin="0,0,0,8"/>
                                                <ui:ToggleSwitch x:Name="PageShowThisMonthTabCheckBox"
                                                               Content="This Month"
                                                               ToolTip="Show or hide the This Month tab"
                                                               IsChecked="True"
                                                               Margin="0,0,0,20"/>
                                                
                                                <!-- Special tabs -->
                                                <TextBlock Text="Special Views" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                                <ui:ToggleSwitch x:Name="PageShowSleepTabCheckBox"
                                                               Content="Sleep"
                                                               ToolTip="Show or hide the Sleep tab"
                                                               IsChecked="True"
                                                               Margin="0,0,0,20"/>
                                                
                                                <!-- Category tabs -->
                                                <TextBlock Text="Categories" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                                <ui:ToggleSwitch x:Name="PageShowWebBrowsingTabCheckBox"
                                                               Content="Web Browsing"
                                                               ToolTip="Show or hide the Web Browsing tab"
                                                               IsChecked="True"
                                                               Margin="0,0,0,8"/>
                                                <ui:ToggleSwitch x:Name="PageShowDevelopmentTabCheckBox"
                                                               Content="Development"
                                                               ToolTip="Show or hide the Development tab"
                                                               IsChecked="True"
                                                               Margin="0,0,0,8"/>
                                                <ui:ToggleSwitch x:Name="PageShowGamingTabCheckBox"
                                                               Content="Gaming"
                                                               ToolTip="Show or hide the Gaming tab"
                                                               IsChecked="True"
                                                               Margin="0,0,0,8"/>
                                                <ui:ToggleSwitch x:Name="PageShowCommunicationTabCheckBox"
                                                               Content="Communication"
                                                               ToolTip="Show or hide the Communication tab"
                                                               IsChecked="True"
                                                               Margin="0,0,0,8"/>
                                                <ui:ToggleSwitch x:Name="PageShowProductivityTabCheckBox"
                                                               Content="Productivity"
                                                               ToolTip="Show or hide the Productivity tab"
                                                               IsChecked="True"
                                                               Margin="0,0,0,8"/>
                                                <ui:ToggleSwitch x:Name="PageShowEntertainmentTabCheckBox"
                                                               Content="Entertainment"
                                                               ToolTip="Show or hide the Entertainment tab"
                                                               IsChecked="True"
                                                               Margin="0,0,0,8"/>
                                                <!-- Custom categories -->
                                                <TextBlock Text="Custom Categories" FontWeight="SemiBold" Margin="12,12,0,8"/>
                                                <ItemsControl x:Name="CustomCategoryTogglesPanel">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ItemsControl>
                                            </StackPanel>
                                        </ui:CardExpander>
                                    </StackPanel>
                                </ui:Card>

                                <!-- Chart Settings Section -->
                                <ui:Card x:Name="ChartSettingsCard" Padding="24" Margin="0,0,0,16" Opacity="0">
                                    <ui:Card.RenderTransform>
                                        <TransformGroup>
                                            <TranslateTransform Y="40"/>
                                            <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                        </TransformGroup>
                                    </ui:Card.RenderTransform>
                                    <StackPanel>
                                        <TextBlock Text="Chart Settings" 
                                                 FontSize="24" 
                                                 FontWeight="SemiBold" 
                                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                 Margin="0,0,0,20"/>

                                        <!-- Chart Filtering -->
                                        <ui:CardExpander Header="Chart Filtering" Icon="📊" Margin="0,0,0,8" IsExpanded="True">
                                            <StackPanel Margin="0,16,0,0">
                                                <TextBlock Text="Configure which categories to include in charts" 
                                                         FontSize="13" 
                                                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                         Margin="0,0,0,16"/>
                                                
                                                <!-- Default categories -->
                                                <TextBlock Text="Default Categories" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                                <ui:ToggleSwitch x:Name="PageShowUncategorizedInChartsCheckBox"
                                                               Content="Include Uncategorized"
                                                               ToolTip="Show uncategorized apps/websites in charts"
                                                               IsChecked="True"
                                                               Margin="0,0,0,8"/>
                                                <ui:ToggleSwitch x:Name="PageShowDevelopmentInChartsCheckBox"
                                                               Content="Include Development"
                                                               ToolTip="Show development apps/websites in charts"
                                                               IsChecked="True"
                                                               Margin="0,0,0,8"/>
                                                <ui:ToggleSwitch x:Name="PageShowGamingInChartsCheckBox"
                                                               Content="Include Gaming"
                                                               ToolTip="Show gaming apps/websites in charts"
                                                               IsChecked="True"
                                                               Margin="0,0,0,8"/>
                                                <ui:ToggleSwitch x:Name="PageShowCommunicationInChartsCheckBox"
                                                               Content="Include Communication"
                                                               ToolTip="Show communication apps/websites in charts"
                                                               IsChecked="True"
                                                               Margin="0,0,0,8"/>
                                                <ui:ToggleSwitch x:Name="PageShowProductivityInChartsCheckBox"
                                                               Content="Include Productivity"
                                                               ToolTip="Show productivity apps/websites in charts"
                                                               IsChecked="True"
                                                               Margin="0,0,0,8"/>
                                                <ui:ToggleSwitch x:Name="PageShowEntertainmentInChartsCheckBox"
                                                               Content="Include Entertainment"
                                                               ToolTip="Show entertainment apps/websites in charts"
                                                               IsChecked="True"
                                                               Margin="0,0,0,16"/>
                                                
                                                <!-- Chart display options -->
                                                <TextBlock Text="Chart Display Options" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                                <ui:ToggleSwitch x:Name="PageShowCustomCategoriesInChartsCheckBox"
                                                               Content="Show custom categories in navigation"
                                                               ToolTip="Display custom categories as navigation tabs"
                                                               IsChecked="True"
                                                               Margin="0,0,0,8"/>
                                                <ui:ToggleSwitch x:Name="PageEnableChartAnimationsCheckBox"
                                                               Content="Enable chart animations"
                                                               ToolTip="Show animated transitions in charts"
                                                               IsChecked="True"
                                                               Margin="0,0,0,8"/>
                                            </StackPanel>
                                        </ui:CardExpander>
                                    </StackPanel>
                                </ui:Card>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
