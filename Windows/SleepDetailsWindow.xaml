<ui:FluentWindow x:Class="chronos_screentime.Windows.SleepDetailsWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                Title="Sleep Details" 
                MinWidth="800" 
                MinHeight="600"
                Width="1000"
                Height="700"
                WindowStartupLocation="CenterOwner"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                ExtendsContentIntoTitleBar="True"
                UseLayoutRounding="True" 
                TextOptions.TextFormattingMode="Display"
                TextOptions.TextRenderingMode="ClearType">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <ui:Card Grid.Row="0" Margin="0,0,0,24" Padding="24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <ui:Button Grid.Column="0"
                          Content="Close"
                          Appearance="Secondary"
                          Click="CloseButton_Click"/>
                          
                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="DateHeader" 
                               Text="Sleep Details"
                               FontSize="20" 
                               FontWeight="SemiBold" 
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>
                
                <TextBlock Grid.Column="2" 
                           Text="🛌" 
                           FontSize="24" 
                           VerticalAlignment="Center"/>
            </Grid>
        </ui:Card>
        
        <!-- Summary Stats -->
        <Grid Grid.Row="1" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <ui:Card Grid.Column="0" Margin="0,0,12,0" Padding="20">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Total Sleep" 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                               FontSize="12" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,8"/>
                    <TextBlock x:Name="TotalSleepText" 
                               Text="0h 0m" 
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                               FontSize="20" 
                               FontWeight="SemiBold" 
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </ui:Card>
            
            <ui:Card Grid.Column="1" Margin="12,0" Padding="20">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Sessions" 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                               FontSize="12" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,8"/>
                    <TextBlock x:Name="SessionCountText" 
                               Text="0" 
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                               FontSize="20" 
                               FontWeight="SemiBold" 
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </ui:Card>
            
            <ui:Card Grid.Column="2" Margin="12,0" Padding="20">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Efficiency" 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                               FontSize="12" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,8"/>
                    <TextBlock x:Name="EfficiencyText" 
                               Text="100%" 
                               Foreground="{DynamicResource AccentFillColorDefaultBrush}" 
                               FontSize="20" 
                               FontWeight="SemiBold" 
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </ui:Card>
            
            <ui:Card Grid.Column="3" Margin="12,0,0,0" Padding="20">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Quality" 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                               FontSize="12" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,8"/>
                    <TextBlock x:Name="QualityText" 
                               Text="Good" 
                               Foreground="{DynamicResource SystemFillColorSuccessBrush}" 
                               FontSize="20" 
                               FontWeight="SemiBold" 
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </ui:Card>
        </Grid>
        
        <!-- Main Content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Sleep Timeline Graph -->
            <ui:Card Grid.Column="0" Margin="0,0,12,0" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" 
                               Text="Sleep Timeline" 
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                               FontSize="16" 
                               FontWeight="SemiBold" 
                               Margin="0,0,0,20"/>
                    
                    <!-- Timeline Canvas -->
                    <Border Grid.Row="1" 
                            Background="{DynamicResource ControlFillColorTransparentBrush}" 
                            CornerRadius="8" 
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" 
                            BorderThickness="1"
                            MinHeight="200"
                            Padding="20">
                        <Canvas x:Name="TimelineCanvas" Background="Transparent"/>
                    </Border>
                    
                    <!-- Time labels -->
                    <StackPanel Grid.Row="2" 
                                Orientation="Horizontal" 
                                HorizontalAlignment="Center" 
                                Margin="0,16,0,0">
                        <TextBlock Text="6 PM" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                   FontSize="11" 
                                   Margin="0,0,30,0"/>
                        <TextBlock Text="12 AM" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                   FontSize="11" 
                                   Margin="0,0,30,0"/>
                        <TextBlock Text="6 AM" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                   FontSize="11" 
                                   Margin="0,0,30,0"/>
                        <TextBlock Text="12 PM" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                   FontSize="11" 
                                   Margin="0,0,30,0"/>
                        <TextBlock Text="6 PM" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                   FontSize="11"/>
                    </StackPanel>
                </Grid>
            </ui:Card>
            
            <!-- Session Details -->
            <ui:Card Grid.Column="1" Margin="12,0,0,0" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" 
                               Text="Session Details" 
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                               FontSize="16" 
                               FontWeight="SemiBold" 
                               Margin="0,0,0,20"/>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="SessionDetailsPanel"/>
                    </ScrollViewer>
                </Grid>
            </ui:Card>
        </Grid>
    </Grid>
</ui:FluentWindow>
