<Window x:Class="chronos_screentime.Windows.CategoryManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:chronos_screentime.Windows"
        Title="Manage App Categories" 
        Height="700" 
        Width="1000"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinHeight="600"
        MinWidth="800"
        Background="{DynamicResource ApplicationBackgroundBrush}">

    <Window.Resources>
        <Style x:Key="CategoryItemStyle" TargetType="ui:CardControl">
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        
        <local:AppWebsiteCountConverter x:Key="AppWebsiteCountConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Manage App Categories" 
                       FontSize="24" 
                       FontWeight="SemiBold" 
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Margin="0,0,0,8"/>
            <TextBlock Text="Organize your apps into categories for better tracking and insights" 
                       FontSize="14" 
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- Quick Actions -->
        <ui:CardControl Grid.Row="1" Margin="0,0,0,16">
            <StackPanel Margin="16">
                <TextBlock Text="Quick Actions" 
                           FontSize="16" 
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Margin="0,0,0,12"/>
                <WrapPanel>
                    <ui:Button x:Name="InitializeTemplatesButton"
                               Content="Initialize with Templates"
                               Icon="Add24"
                               Click="InitializeTemplatesButton_Click"
                               Margin="0,0,8,8"/>
                    <ui:Button x:Name="AutoCategorizeButton"
                               Content="Auto-Categorize All Apps &amp; Websites"
                               Icon="Auto24"
                               Click="AutoCategorizeButton_Click"
                               Margin="0,0,8,8"/>
                    <ui:Button x:Name="CategorizeExistingButton"
                               Content="Categorize Existing Items"
                               Icon="Tag24"
                               Click="CategorizeExistingButton_Click"
                               Margin="0,0,8,8"/>
                    <ui:Button x:Name="ShowTemplatesButton"
                               Content="View Templates"
                               Icon="Info24"
                               Click="ShowTemplatesButton_Click"
                               Margin="0,0,8,8"/>
                </WrapPanel>
            </StackPanel>
        </ui:CardControl>

        <!-- Main Content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - Categories -->
            <ui:CardControl Grid.Column="0" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Categories Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" 
                                   Text="Categories" 
                                   FontSize="16" 
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <ui:Button Grid.Column="1" 
                                   x:Name="ShowAllAppsButton"
                                   Content="Show All Apps"
                                   Icon="List24"
                                   Click="ShowAllAppsButton_Click"
                                   Margin="20,0,8,0"/>
                        <ui:Button Grid.Column="2" 
                                   x:Name="AddCategoryButton"
                                   Content="Add Category"
                                   Icon="Add24"
                                   Click="AddCategoryButton_Click"/>
                    </Grid>

                    <!-- Categories List -->
                    <ScrollViewer Grid.Row="1" 
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ListBox x:Name="CategoriesList" 
                                 SelectionMode="Single"
                                 SelectionChanged="CategoriesList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <ui:CardControl Style="{StaticResource CategoryItemStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" 
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                <TextBlock FontSize="12"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource AppWebsiteCountConverter}">
                                                            <Binding Path="AppCount"/>
                                                            <Binding Path="WebsiteCount"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                            
                                            <ui:Button Grid.Column="1" 
                                                       x:Name="EditCategoryButton"
                                                       Content="Edit"
                                                       Icon="Edit24"
                                                       Margin="8,0,0,0"
                                                       Click="EditCategoryButton_Click"
                                                       Tag="{Binding Name}"/>
                                            
                                            <ui:Button Grid.Column="2" 
                                                       x:Name="DeleteCategoryButton"
                                                       Content="Delete"
                                                       Icon="Delete24"
                                                       Margin="4,0,0,0"
                                                       Click="DeleteCategoryButton_Click"
                                                       Tag="{Binding Name}"
                                                       Visibility="{Binding IsCustom, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </Grid>
                                    </ui:CardControl>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>

                    <!-- Category Actions -->
                    <StackPanel Grid.Row="2" 
                                Orientation="Horizontal" 
                                HorizontalAlignment="Right"
                                Margin="0,12,0,0">
                        <ui:Button x:Name="ResetToDefaultsButton"
                                   Content="Reset to Defaults"
                                   Click="ResetToDefaultsButton_Click"
                                   Margin="0,0,8,0"/>
                        <ui:Button x:Name="ClearAllButton"
                                   Content="Clear All"
                                   Click="ClearAllButton_Click"/>
                    </StackPanel>
                </Grid>
            </ui:CardControl>

            <!-- Separator -->
            <GridSplitter Grid.Column="1" 
                          Width="4" 
                          HorizontalAlignment="Center"
                          Background="{DynamicResource ControlFillColorDefaultBrush}"/>

            <!-- Right Panel - All Apps -->
            <ui:CardControl Grid.Column="2" Margin="10,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Apps Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" 
                                   x:Name="AppsHeaderText"
                                   Text="All Apps" 
                                   FontSize="16" 
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <ui:Button Grid.Column="1" 
                                   x:Name="TransferToCategoryButton"
                                   Content="Transfer to Category"
                                   Icon="ArrowRight24"
                                   Click="TransferToCategoryButton_Click"
                                   Visibility="Collapsed"/>
                    </Grid>

                    <!-- Apps List -->
                    <ScrollViewer Grid.Row="1" 
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="AppsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:CardControl Style="{StaticResource CategoryItemStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <CheckBox Grid.Column="0" 
                                                      x:Name="AppCheckBox"
                                                      IsChecked="{Binding IsSelected}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,12,0"/>
                                            
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" 
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Category}" 
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Text="{Binding FormattedTotalTimeShort}" 
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </ui:CardControl>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- App Actions -->
                    <StackPanel Grid.Row="2" 
                                Orientation="Horizontal" 
                                HorizontalAlignment="Right"
                                Margin="0,12,0,0">
                        <ui:Button x:Name="SelectAllItemsButton"
                                   Content="Select All"
                                   Click="SelectAllItemsButton_Click"
                                   Margin="0,0,8,0"/>
                        <ui:Button x:Name="DeselectAllItemsButton"
                                   Content="Deselect All"
                                   Click="DeselectAllItemsButton_Click"/>
                    </StackPanel>
                </Grid>
            </ui:CardControl>
        </Grid>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="3" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <ui:Button x:Name="CancelButton"
                       Content="Cancel"
                       Click="CancelButton_Click"
                       Margin="0,0,12,0"/>
            <ui:Button x:Name="SaveButton"
                       Content="Save"
                       Appearance="Primary"
                       Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window> 